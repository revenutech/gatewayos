{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "title": "Overview",
      "type": "row"
    },
    {
      "title": "Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/krakend/router/response/count",
        "crossSeriesReducer": "REDUCE_SUM",
        "perSeriesAligner": "ALIGN_RATE",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "gradientMode": "scheme" }
        }
      }
    },
    {
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/krakend/router/response/error",
        "crossSeriesReducer": "REDUCE_SUM",
        "perSeriesAligner": "ALIGN_RATE",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "title": "Latency P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [
        {
          "metricType": "custom.googleapis.com/opencensus/krakend/router/response/latency",
          "perSeriesAligner": "ALIGN_PERCENTILE_50",
          "alignmentPeriod": "60s",
          "legendTemplate": "P50"
        },
        {
          "metricType": "custom.googleapis.com/opencensus/krakend/router/response/latency",
          "perSeriesAligner": "ALIGN_PERCENTILE_95",
          "alignmentPeriod": "60s",
          "legendTemplate": "P95"
        },
        {
          "metricType": "custom.googleapis.com/opencensus/krakend/router/response/latency",
          "perSeriesAligner": "ALIGN_PERCENTILE_99",
          "alignmentPeriod": "60s",
          "legendTemplate": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "title": "Backend Health",
      "type": "row"
    },
    {
      "title": "Backend Latency P95 by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/krakend/backend/response/latency",
        "perSeriesAligner": "ALIGN_PERCENTILE_95",
        "crossSeriesReducer": "REDUCE_MEAN",
        "groupBys": ["metric.label.backend"],
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 5 } }
      }
    },
    {
      "title": "Backend Errors by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/krakend/backend/response/error",
        "perSeriesAligner": "ALIGN_RATE",
        "crossSeriesReducer": "REDUCE_SUM",
        "groupBys": ["metric.label.backend"],
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 50 } }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "title": "Security",
      "type": "row"
    },
    {
      "title": "Auth Failures (401/403)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "logging.googleapis.com/log_entry_count",
        "filters": ["resource.type = \"k8s_container\"", "resource.labels.container_name = \"krakend\"", "metric.labels.severity >= \"WARNING\""],
        "perSeriesAligner": "ALIGN_RATE",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "title": "Rate Limited (429)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 19 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/krakend/router/response/count",
        "filters": ["metric.labels.status_code = \"429\""],
        "perSeriesAligner": "ALIGN_SUM",
        "alignmentPeriod": "3600s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "title": "Blocked by Security Policies",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 19 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "logging.googleapis.com/user/security_blocked",
        "perSeriesAligner": "ALIGN_SUM",
        "alignmentPeriod": "3600s"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "title": "Top Blocked IPs (last 1h)",
      "type": "table",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "logging.googleapis.com/user/security_blocked",
        "groupBys": ["metric.labels.source_ip"],
        "perSeriesAligner": "ALIGN_SUM",
        "crossSeriesReducer": "REDUCE_SUM",
        "alignmentPeriod": "3600s"
      }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "title": "Infrastructure",
      "type": "row"
    },
    {
      "title": "CPU Usage (cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "kubernetes.io/container/cpu/core_usage_time",
        "filters": ["resource.labels.container_name = \"krakend\""],
        "perSeriesAligner": "ALIGN_RATE",
        "crossSeriesReducer": "REDUCE_MEAN",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "kubernetes.io/container/memory/used_bytes",
        "filters": ["resource.labels.container_name = \"krakend\""],
        "perSeriesAligner": "ALIGN_MEAN",
        "crossSeriesReducer": "REDUCE_MEAN",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": { "defaults": { "unit": "decbytes" } }
    },
    {
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "kubernetes.io/container/restart_count",
        "filters": ["resource.labels.container_name = \"krakend\""],
        "perSeriesAligner": "ALIGN_DELTA",
        "alignmentPeriod": "300s"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars" } } }
    },
    {
      "title": "OTel Collector Spans/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "stackdriver", "uid": "google-cloud-monitoring" },
      "targets": [{
        "metricType": "custom.googleapis.com/opencensus/otel_collector/exporter/sent_spans",
        "perSeriesAligner": "ALIGN_RATE",
        "alignmentPeriod": "60s"
      }],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    }
  ],
  "schemaVersion": 39,
  "tags": ["gateway", "revenu", "krakend"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "America/Sao_Paulo",
  "title": "Revenu Gateway",
  "uid": "revenu-gateway",
  "version": 1
}
