    "financeos": "http://financeos:8095",
    "keycloak": "http://keycloak:8080"
  },
  "redis": {
    "host": "redis",
    "port": "6379"
  },
  "rate_limit": {
    "global_max": 5000,
    "tenant_max": 500
  },
  "cors": {
    "allow_origins": [
      "https://develop.app.revenu.tech",
      "http://localhost:3000",
      "http://localhost:8080"
    ],
    "allow_methods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "PATCH",
      "OPTIONS"
    ],
    "allow_headers": [
      "Authorization",
      "Content-Type",
      "X-Correlation-ID"
    ],
    "max_age": "12h"
  },
  "cb_posting": {
    "cb_name": "cb-ledgeros-posting",
    "cb_max_errors": 5,
    "cb_interval": 60,
    "cb_timeout": 10
  },
  "cb_paymentos": {
    "cb_name": "cb-paymentos",
    "cb_max_errors": 3,
    "cb_interval": 60,
    "cb_timeout": 15
  },
  "cb_atmos": {
    "cb_name": "cb-atmos",
    "cb_max_errors": 10,
    "cb_interval": 120,
    "cb_timeout": 30
  },
  "cb_grpc_posting": {
    "cb_name": "cb-ledgeros-grpc",
    "cb_max_errors": 5,
    "cb_interval": 60,
    "cb_timeout": 10
  },
  "cb_onboardos": {
    "cb_name": "cb-onboardos",
    "cb_max_errors": 5,
    "cb_interval": 60,
    "cb_timeout": 10
  },
  "cb_accountos": {
    "cb_name": "cb-accountos",
    "cb_max_errors": 5,
    "cb_interval": 60,
    "cb_timeout": 10
  },
  "cb_financeos": {
    "cb_name": "cb-financeos",
