{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "revenu-platform-gateway",
  "port": {{ .service.port }},
  "timeout": "65s",
  "cache_ttl": "300s",
  "extra_config": {
    {{ template "telemetry.tmpl" . }},
    {{ template "cors.tmpl" . }},
    {{ template "security_headers.tmpl" . }},
    {{ template "bloom_filter.tmpl" . }},
    "telemetry/logging": {
      "level": "{{ .service.log_level }}",
      "prefix": "[KRAKEND]",
      "stdout": true,
      "format": "logstash"
    },
    "router": {
      "return_error_msg": {{ .service.return_error_msg }}
    }
  },
  "endpoints": [
    {{ template "endpoint_health.tmpl" . }}
    ,{{ template "endpoint_ledger_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_v1_lifecycle.tmpl" . }}
    ,{{ template "endpoint_paymentos_oauth_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_jdpi_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_ted_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_banklink_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_routing_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_temenos_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_health_v1.tmpl" . }}
    ,{{ template "endpoint_paymentos_qrcode_public_v1.tmpl" . }}
    ,{{ template "endpoint_identityos_v1.tmpl" . }}
    ,{{ template "endpoint_atmos_v1.tmpl" . }}
    ,{{ template "endpoint_admin_v1.tmpl" . }}
    ,{{ template "endpoint_ledger_grpc_v1.tmpl" . }}
    ,{{ template "endpoint_ledger_dynamic_v1.tmpl" . }}
    ,{{ template "endpoint_onboardos_v1.tmpl" . }}
    ,{{ template "endpoint_accountos_v1.tmpl" . }}
    ,{{ template "endpoint_financeos_v1.tmpl" . }}
    ,{{ template "endpoint_dashboard_v1.tmpl" . }}
    {{ if .service.expose_test_endpoints }},{{ template "endpoint_test_v1.tmpl" . }}{{ end }}
    ,{{ template "endpoint_keycloak_v1.tmpl" . }}
    {{ if .service.expose_docs }},{{ template "endpoint_docs_v1.tmpl" . }}{{ end }}
  ]
}
