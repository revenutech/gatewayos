"modifier/lua-endpoint": {
  "sources": ["/etc/krakend/partials/lua/response_cache.lua"],
  "pre": "pre_proxy",
  "live": false,
  "allow_open_libs": true,
  "extra_config": {
    "dynamic_config": {
      "redis_host": "{{ .redis.host }}",
      "redis_port": "{{ .redis.port }}",
      "cache_ttl": "{{ or .cache_ttl "60" }}"
    }
  }
},
"modifier/lua-proxy": {
  "sources": ["/etc/krakend/partials/lua/response_cache.lua"],
  "post": "post_proxy",
  "live": false,
  "allow_open_libs": true,
  "extra_config": {
    "dynamic_config": {
      "redis_host": "{{ .redis.host }}",
      "redis_port": "{{ .redis.port }}",
      "cache_ttl": "{{ or .cache_ttl "60" }}"
    }
  }
}