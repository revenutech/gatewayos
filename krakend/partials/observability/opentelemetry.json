{{/* =============================================================================
  Revenu Platform Gateway - OpenTelemetry Tracing Export
  ISO 27001: A.12.4.1 (Event logging)
  Distributed tracing via OTLP gRPC exporter
  Migrated from: ledgeros/deployment/krakend/partials/observability/opentelemetry.json
============================================================================= */}}
"telemetry/opentelemetry": {
  "service_name": "revenu-platform-gateway",
  "service_version": "1.0.0",
  "exporters": {
    "otlp": [{
      "name": "otel-collector",
      "host": "{{ .tracing.otel_host }}",
      "port": {{ .tracing.otel_port }},
      "use_http": false
    }]
  },
  "sample_rate": {{ .tracing.sample_rate }},
  "layers": {
    "global": { "report_headers": true, "disable_metrics": false, "disable_traces": false },
    "proxy": { "report_headers": true, "disable_metrics": false, "disable_traces": false },
    "backend": {
      "metrics": { "report_headers": true, "disable_stage": false },
      "traces": { "report_headers": true, "disable_stage": false, "round_trip": true }
    }
  }
}
