{{/* =============================================================================
  Revenu Platform Gateway - Rate Limiting Configuration
  ISO 27001: A.12.1.3 (Capacity management)
  Tiered rate limiting by X-Tenant-ID

  Valores para ambiente bancário (por minuto):
  - global_max: 3000 req/min (50 req/s) - limite global do endpoint
  - tenant_max: 600 req/min (10 req/s) - limite por tenant/cliente

  Estes valores são adequados para SQA. Em produção, ajustar conforme SLA.
============================================================================= */}}
"qos/ratelimit/router": {
  "max_rate": {{ .rate_limit.global_max }},
  "client_max_rate": {{ .rate_limit.tenant_max }},
  "strategy": "header",
  "key": "X-Tenant-ID",
  "every": "1m"
}
