{{/* =============================================================================
  Revenu Platform Gateway - Security Policies
  Enterprise KrakenD equivalent: security/policies (CEL-based engine)
  ISO 27001: A.9.4.1 (Information access restriction), A.14.2.5 (Secure system engineering)

  Comprehensive CEL validation rules applied at the endpoint level.
  These policies enforce tenant isolation, request integrity, and abuse prevention.
============================================================================= */}}
"validation/cel": [
  {
    "_comment": "Tenant isolation: X-Tenant-ID header must be present and non-empty",
    "check_expr": "has(req_headers['X-Tenant-Id']) && size(req_headers['X-Tenant-Id']) > 0"
  },
  {
    "_comment": "Correlation ID: requests should carry a correlation ID for tracing",
    "check_expr": "has(req_headers['X-Correlation-Id']) && size(req_headers['X-Correlation-Id']) > 0"
  },
  {
    "_comment": "Content-Type enforcement: POST/PUT/PATCH must send JSON",
    "check_expr": "req_method in ['GET', 'DELETE', 'OPTIONS'] || (has(req_headers['Content-Type']) && req_headers['Content-Type'].startsWith('application/json'))"
  },
  {
    "_comment": "Path traversal prevention: URL must not contain path traversal sequences",
    "check_expr": "!req_path.contains('..') && !req_path.contains('//') && !req_path.contains('\\\\') && !req_path.contains('%2e%2e') && !req_path.contains('%252e')"
  },
  {
    "_comment": "Query string size limit: prevent oversized query strings (max 2KB)",
    "check_expr": "size(req_querystring) < 2048"
  }
]
