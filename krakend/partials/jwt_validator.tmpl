"auth/validator": {
  "alg": "RS256",
  "jwk_url": "{{ .keycloak.jwks_url }}",
  "issuer": "{{ .keycloak.issuer }}",
  "audience": ["{{ .keycloak.audience }}"],
  "cache": true,
  "cache_duration": 3600,
  "failed_jwk_key_cooldown": "10s",
  "disable_jwk_security": {{ if .keycloak.disable_jwk_security }}{{ .keycloak.disable_jwk_security }}{{ else }}false{{ end }},
  "propagate_claims": [
    ["sub", "x-user-id"],
    ["tenant_id", "x-tenant-id"],
    ["realm_access.roles", "x-roles"],
    ["jti", "x-jwt-jti"]
  ]
}