{
  "$schema": "https://www.krakend.io/schema/krakend.json",
  "version": 3,
  "name": "revenu-platform-gateway",
  "port": 8080,
  "timeout": "3000ms",
  "cache_ttl": "300s",
  "extra_config": {
    "telemetry/opentelemetry": {
      "service_name": "krakend-gateway",
      "service_version": "1.0.0",
      "exporters": {
        "otlp": [
          {
            "name": "otel-collector",
            "host": "otel-collector",
            "port": 4317,
            "use_http": false
          }
        ]
      },
      "layers": {
        "global": {
          "report_headers": true
        },
        "proxy": {
          "report_headers": true
        },
        "backend": {
          "metrics": {
            "report_headers": true
          },
          "traces": {
            "report_headers": true
          }
        }
      }
    },
    "telemetry/metrics": {
      "collection_time": "30s",
      "listen_address": ":8090"
    },
    "security/cors": {
      "allow_origins": [
        "http://localhost:3000",
        "http://localhost:8081"
      ],
      "allow_methods": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "OPTIONS"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "X-Correlation-ID"
      ],
      "expose_headers": [
        "X-Request-ID",
        "X-Correlation-ID"
      ],
      "max_age": "12h",
      "allow_credentials": true
    },
    "security/http": {
      "allowed_hosts": [],
      "ssl_redirect": false,
      "ssl_host": "",
      "ssl_proxy_headers": {
        "X-Forwarded-Proto": "https"
      },
      "sts_seconds": 31536000,
      "sts_include_subdomains": true,
      "frame_deny": true,
      "content_type_nosniff": true,
      "browser_xss_filter": true,
      "content_security_policy": "default-src 'self'",
      "referrer_policy": "strict-origin-when-cross-origin",
      "custom_frame_options_value": "DENY"
    },
    "auth/revoker": {
      "N": 10000000,
      "P": 1e-07,
      "hash_name": "optimal",
      "TTL": 3600,
      "port": 1234,
      "token_keys": [
        "jti"
      ]
    },
    "telemetry/logging": {
      "level": "DEBUG",
      "prefix": "[KRAKEND]",
      "stdout": true,
      "format": "logstash"
    },
    "router": {
      "return_error_msg": true
    }
  },
  "endpoints": [
    {
      "endpoint": "/__ready",
      "method": "GET",
      "output_encoding": "no-op",
      "backend": [
        {
          "host": [
            "http://ledgeros:8081"
          ],
          "url_pattern": "/health",
          "encoding": "no-op"
        }
      ]
    },
    {
      "endpoint": "/v1/postings",
      "method": "POST",
      "input_headers": [
        "X-User-ID",
        "X-Tenant-ID",
        "X-Roles",
        "X-Correlation-ID",
        "Content-Type"
      ],
      "output_encoding": "json",
      "extra_config": {
        "auth/validator": {
          "roles_key": "realm_access.roles",
          "roles_key_is_nested": true,
          "roles": [
            "ledger-operator",
            "ledger-admin"
          ]
        }
      },
      "backend": [
        {
          "host": [
            "http://ledgeros:8081"
          ],
          "url_pattern": "/v1/transactions",
          "encoding": "json",
          "extra_config": {}
