    {
      "endpoint": "/v1/auth/{path}",
      "method": "POST",
      "input_headers": [
        "X-User-ID",
        "X-Tenant-ID",
        "X-Roles",
        "X-Correlation-ID",
        "Content-Type"
      ],
      "output_encoding": "no-op",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://keycloak:8180/realms/ledgeros/protocol/openid-connect/certs",
          "issuer": "http://keycloak:8180/realms/ledgeros",
          "audience": [
            "revenu-platform"
          ],
          "cache": true,
          "cache_duration": 3600,
          "failed_jwk_key_cooldown": "10s",
          "disable_jwk_security": true,
          "propagate_claims": [
            [
              "sub",
              "x-user-id"
            ],
            [
              "tenant_id",
              "x-tenant-id"
            ],
            [
              "realm_access.roles",
              "x-roles"
            ],
            [
              "jti",
              "x-jwt-jti"
            ],
            [
              "subscription_tier",
              "x-subscription-tier"
            ]
          ]
        }
      },
      "backend": [
        {
          "host": [
            "http://identos:8091"
          ],
          "url_pattern": "/v1/auth/{path}",
          "encoding": "no-op",
          "extra_config": {}
        }
      ]
    },
