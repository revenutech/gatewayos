{
  "_comment": "OnboardOS — Customer onboarding module (:8092)",
  "_enterprise_equivalent": "endpoints/wildcard — KrakenD Enterprise wildcard routes",
  "_prefixes": "onboarding, kyc, dd, journeys, documents, leads, risk, rio, aml, screenings, cases, policies, reviews, offboarding, mdm, audit, sessions, milestones, notifications, business-entities, cnpj, oauth, enrichment",

  "endpoint": "/onboardos/v1/onboarding/{path}",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "no-op",
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.onboardos }}"],
    "url_pattern": "/v1/onboarding/{path}",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_onboardos }}
    }
  }]
},
