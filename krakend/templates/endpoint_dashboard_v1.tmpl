{
  "_comment": "Aggregated Dashboard Endpoints — multi-backend in single response",
  "_enterprise_equivalent": "KrakenD CE native feature (multiple backends per endpoint)",

  "endpoint": "/dashboard/v1/overview",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "json",
  "timeout": "5000ms",
  "concurrent_calls": 4,
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    }
  },
  "backend": [
    {
      "host": ["{{ .backends.ledgeros_http }}"],
      "url_pattern": "/v1/dashboard/ledger-summary",
      "encoding": "json",
      "group": "ledger",
      "timeout": "3000ms",
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_posting }},
        "qos/http-cache": { "shared": true }
      }
    },
    {
      "host": ["{{ .backends.paymentos }}"],
      "url_pattern": "/v1/dashboard/payment-summary",
      "encoding": "json",
      "group": "payments",
      "timeout": "3000ms",
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_paymentos }}
      }
    },
    {
      "host": ["{{ .backends.atmos }}"],
      "url_pattern": "/v1/dashboard/automation-summary",
      "encoding": "json",
      "group": "automation",
      "timeout": "3000ms",
      "is_collection": true,
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_atmos }}
      }
    },
    {
      "host": ["{{ .backends.accountos }}"],
      "url_pattern": "/v1/dashboard/account-summary",
      "encoding": "json",
      "group": "accounts",
      "timeout": "3000ms",
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_accountos }}
      }
    }
  ]
},
{
  "_comment": "Aggregated health — all backends in one call",
  "endpoint": "/dashboard/v1/health",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID"],
  "output_encoding": "json",
  "timeout": "3000ms",
  "concurrent_calls": 5,
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-admin"]
    }
  },
  "backend": [
    {
      "host": ["{{ .backends.ledgeros_http }}"],
      "url_pattern": "/health",
      "encoding": "json",
      "group": "ledgeros"
    },
    {
      "host": ["{{ .backends.paymentos }}"],
      "url_pattern": "/health",
      "encoding": "json",
      "group": "paymentos"
    },
    {
      "host": ["{{ .backends.atmos }}"],
      "url_pattern": "/health",
      "encoding": "json",
      "group": "atmos"
    },
    {
      "host": ["{{ .backends.identityos }}"],
      "url_pattern": "/health",
      "encoding": "json",
      "group": "identityos"
    },
    {
      "host": ["{{ .backends.accountos }}"],
      "url_pattern": "/health",
      "encoding": "json",
      "group": "accountos"
    }
  ]
}
