{
  "_comment": "LedgerOS - Detailed Reconciliation API Endpoints (get, matches, approve, reject)",
  "_iso27001": "A.9.4.1 (Information access restriction)",
  "_migrated_from": "ledgeros/deployment/krakend/partials/endpoints/reconciliation.json",
  "endpoint": "/ledgeros/v1/reconciliation/jobs/{id}",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Correlation-ID"],
  "output_encoding": "json",
  "timeout": "3s",
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/reconciliation/jobs/{id}",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-recon-get", "log_status_change": true },
      "backend/http": { "return_error_code": true }
    }
  }]
},
{
  "endpoint": "/ledgeros/v1/reconciliation/jobs/{id}/matches",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Correlation-ID"],
  "input_query_strings": ["*"],
  "output_encoding": "json",
  "timeout": "5s",
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/reconciliation/jobs/{id}/matches",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-recon-matches", "log_status_change": true },
      "backend/http": { "return_error_code": true }
    }
  }]
},
{
  "endpoint": "/ledgeros/v1/reconciliation/matches/{id}/approve",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Correlation-ID", "Content-Type"],
  "output_encoding": "json",
  "timeout": "5s",
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/reconciliation/matches/{id}/approve",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-recon-approve", "log_status_change": true },
      "backend/http": { "return_error_code": true, "return_error_msg": true }
    }
  }]
},
{
  "endpoint": "/ledgeros/v1/reconciliation/matches/{id}/reject",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Correlation-ID", "Content-Type"],
  "output_encoding": "json",
  "timeout": "5s",
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/reconciliation/matches/{id}/reject",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-recon-reject", "log_status_change": true },
      "backend/http": { "return_error_code": true, "return_error_msg": true }
    }
  }]
}
