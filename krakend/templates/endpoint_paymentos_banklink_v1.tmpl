{
  "_comment": "BankLink Compatibility Layer — BASA Integration endpoints",
  "_note": "These endpoints translate BankLink API format to JDPI native format for BASA bank integration",

  "endpoint": "/paymentos/banklink/pix/seguranca/connect/token",
  "method": "POST",
  "input_headers": ["Content-Type", "Authorization", "X-Correlation-ID", "X-Client-ID"],
  "output_encoding": "no-op",
  "extra_config": {
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-operator", "ledger-admin", "banklink-client"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/banklink/pix/seguranca/connect/token",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_paymentos }}
    }
  }]
},
