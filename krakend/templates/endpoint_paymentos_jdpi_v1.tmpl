{
  "_comment": "JDPI Native API — DICT, SPI, QRCode, Account operations",
  "_note": "Routes are organized by depth level to avoid Gin wildcard conflicts",

  "endpoint": "/paymentos/jdpi/connect/token",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Content-Type", "Authorization"],
  "output_encoding": "no-op",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }}
  },
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/jdpi/connect/token",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_paymentos }}
    }
  }]
},
{
  "endpoint": "/paymentos/jdpi/certificates/download",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Authorization", "If-None-Match"],
  "output_encoding": "no-op",
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/jdpi/certificates/download",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_paymentos }}
    }
  }]
},

