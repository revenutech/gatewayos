{
  "_comment": "LedgerOS - Detailed Ledger API Endpoints (confirm, balance search/block/unblock)",
  "_iso27001": "A.9.4.1 (Information access restriction)",
  "_migrated_from": "ledgeros/deployment/krakend/partials/endpoints/ledger.json",
  "endpoint": "/v1/postings/{id}/confirm",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Correlation-ID", "Content-Type"],
  "output_encoding": "json",
  "timeout": "5s",
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/transactions/{id}/confirm",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-postings-confirm", "log_status_change": true },
      "backend/http": { "return_error_code": true, "return_error_msg": true }
    }
  }]
},
{
