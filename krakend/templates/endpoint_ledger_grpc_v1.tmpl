{
  "_comment": "LedgerOS gRPC endpoints via Envoy transcoder sidecar (127.0.0.1:8085)",
  "_enterprise_equivalent": "backend/grpc — KrakenD Enterprise native gRPC support",

  "endpoint": "/ledgeros/grpc/v1/postings",
  "method": "POST",
  "input_headers": ["Authorization", "X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Content-Type"],
  "output_encoding": "json",
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-operator", "ledger-admin"]
    },
    {{ template "rate_limiter.tmpl" .postings_write }}
  },
  "backend": [{
    "host": ["{{ .backends.ledgeros_grpc_transcoder }}"],
    "url_pattern": "/grpc/v1/postings",
    "encoding": "json",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_grpc_posting }}
    }
  }]
},
