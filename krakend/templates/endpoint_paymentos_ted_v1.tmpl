{
  "_comment": "TED JDSPB Cabine — passthrough surface mounted at /corebanx/ted (canonical) and /jdpi/ted (legacy mirror). Implements the 5 cabine WS methods: enviar, enviar/ctrlif, receber, consultar/{NumCabSeq}, consultar/ctrlif/{NumCtrlIF}.",
  "endpoint": "/paymentos/corebanx/ted/enviar",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Content-Type", "Authorization"],
  "output_encoding": "no-op",
  "extra_config": {
    "modifier/lua-endpoint": {
      "sources": ["/etc/krakend/partials/lua/jwe_guard.lua"],
      "live": false,
      "allow_open_libs": false
    },
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"],
        ["subscription_tier", "x-subscription-tier"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-operator", "ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/corebanx/ted/enviar",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_paymentos }}
    }
  }]
},
