{
  "_comment": "=== OAUTH TOKEN - No Auth Required ===",
  "endpoint": "/paymentos/v1/oauth/token",
  "method": "POST",
  "input_headers": ["Content-Type", "Authorization"],
  "output_encoding": "no-op",
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/v1/oauth/token",
    "encoding": "no-op"
  }]
},
