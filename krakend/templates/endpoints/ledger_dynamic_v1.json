{
  "_comment": "LedgerOS dynamic routing endpoints — tenant-scoped via JWT claims",
  "_enterprise_equivalent": "endpoints/dynamic-routing — KrakenD Enterprise",

  "endpoint": "/v1/my/postings",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "json",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    },
    {{ template "rate_limiter.tmpl" .balances_read }}
  },
  "backend": [{
    "host": ["{{ .backends.ledgeros_http }}"],
    "url_pattern": "/internal/v1/tenants/{JWT.tenant_id}/transactions",
    "encoding": "json",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_posting }}
    }
  }]
},
{
  "_comment": "User-scoped balances — routes to user-specific backend path",
  "endpoint": "/v1/my/balances",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "json",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    },
    {{ template "rate_limiter.tmpl" .balances_read }}
  },
  "backend": [{
    "host": ["{{ .backends.ledgeros_http }}"],
    "url_pattern": "/internal/v1/users/{JWT.sub}/balances",
    "encoding": "json",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_posting }}
    }
  }]
},
{
  "_comment": "Tenant dashboard — aggregated view scoped to JWT tenant",
  "endpoint": "/v1/my/dashboard",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "json",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    }
  },
  "backend": [
    {
      "host": ["{{ .backends.ledgeros_http }}"],
      "url_pattern": "/internal/v1/tenants/{JWT.tenant_id}/summary",
      "encoding": "json",
      "group": "ledger",
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_posting }}
      }
    },
    {
      "host": ["{{ .backends.paymentos }}"],
      "url_pattern": "/internal/v1/tenants/{JWT.tenant_id}/payment-summary",
      "encoding": "json",
      "group": "payments",
      "extra_config": {
        {{ template "circuit_breaker.tmpl" .cb_paymentos }}
      }
    }
  ]
}
