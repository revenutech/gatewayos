"telemetry/opentelemetry": {
  "service_name": "krakend-gateway",
  "service_version": "1.0.0",
  "exporters": {
    "otlp": [
      {
        "name": "otel-collector",
        "host": "{{ .tracing.otel_host }}",
        "port": {{ .tracing.otel_port }},
        "use_http": false
      }
    ]
  },
  "layers": {
    "global": {
      "report_headers": true
    },
    "proxy": {
      "report_headers": true
    },
    "backend": {
      "metrics": {
        "report_headers": true
      },
      "traces": {
        "report_headers": true
      }
    }
  }
},
"telemetry/metrics": {
  "collection_time": "30s",
  "listen_address": ":8090"
}