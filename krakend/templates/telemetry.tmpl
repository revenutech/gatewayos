"telemetry/opentelemetry": {
  "service_name": "krakend-gateway",
  "service_version": "1.0.0",
  "exporters": {
    "otlp": [
      {
        "name": "otel-collector",
        "host": "otel-collector.monitoring.svc.cluster.local",
        "port": 4317,
        "use_http": false
      }
    ]
  },
  "layers": {
    "global": {
      "report_headers": true
    },
    "proxy": {
      "report_headers": true
    },
    "backend": {
      "metrics": {
        "report_headers": true
      },
      "traces": {
        "report_headers": true
      }
    }
  }
},
"telemetry/metrics": {
  "collection_time": "30s",
  "listen_address": ":8090"
}