{
  "_comment": "LedgerOS - Detailed Settlement API Endpoints (list, get, post, sweep)",
  "_iso27001": "A.9.4.1 (Information access restriction)",
  "_migrated_from": "ledgeros/deployment/krakend/partials/endpoints/settlement.json",
  "endpoint": "/ledgeros/v1/settlements",
  "method": "GET",
  "input_headers": ["Authorization", "X-User-ID", "X-Tenant-ID", "X-Correlation-ID"],
  "input_query_strings": ["*"],
  "output_encoding": "json",
  "timeout": "3s",
  "extra_config": {
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "failed_jwk_key_cooldown": "10s",
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"],
        ["jti", "x-jwt-jti"]
      ],
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin", "ledger-auditor"]
    }
  },
  "backend": [{
    "host": ["{{ env "API_SERVER_HOST" "http://api-server:8081" }}"],
    "url_pattern": "/v1/settlements",
    "encoding": "json",
    "extra_config": {
      "qos/circuit-breaker": { "interval": 60, "timeout": 10, "max_errors": 5, "name": "cb-settlements-list", "log_status_change": true },
      "backend/http": { "return_error_code": true }
    }
  }]
},
{
