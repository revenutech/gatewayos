{{/*
  endpoint_paymentos_v1_lifecycle.tmpl
  Paymentos v1 REST surface — collection roots + lifecycle/sub-resource actions
  not covered by the single-segment {path} wildcards in endpoint_paymentos_v1.tmpl.
  Position-1 path params are named {path} to reuse the existing wildcard slot and
  avoid Gin router conflicts (see commit 78c0257). Included after the base v1
  template in krakend.tmpl.
*/}}
{
  "_comment": "BOLETO lifecycle — DELETE /v1/boleto/dda/payer/{id}",
  "endpoint": "/paymentos/v1/boleto/dda/payer/{id}",
  "method": "DELETE",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Authorization"],
  "output_encoding": "no-op",
  "extra_config": {
    "auth/validator": {
      "alg": "RS256",
      "jwk_url": "{{ .keycloak.jwks_url }}",
      "issuer": "{{ .keycloak.issuer }}",
      "audience": ["{{ .keycloak.audience }}"],
      "cache": true,
      "cache_duration": 3600,
      "disable_jwk_security": {{ .keycloak.disable_jwk_security }},
      "propagate_claims": [
        ["sub", "x-user-id"],
        ["tenant_id", "x-tenant-id"],
        ["realm_access.roles", "x-roles"]
      ]
    }
  },
  "backend": [{
    "host": ["{{ .backends.paymentos }}"],
    "url_pattern": "/v1/boleto/dda/payer/{id}",
    "encoding": "no-op"
  }]
},
