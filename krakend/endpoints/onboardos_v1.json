{
  "_comment": "OnboardOS — Customer onboarding module (:8092)",
  "_enterprise_equivalent": "endpoints/wildcard — KrakenD Enterprise wildcard routes",

  "endpoint": "/v1/onboarding/{path}",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Content-Type", "X-Subscription-Tier"],
  "output_encoding": "no-op",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-operator", "ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.onboardos }}"],
    "url_pattern": "/v1/onboarding/{path}",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_onboardos }}
    }
  }]
},
{
  "endpoint": "/v1/onboarding/{path}",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "X-Subscription-Tier"],
  "output_encoding": "no-op",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles_key_is_nested": true,
      "roles": ["ledger-viewer", "ledger-operator", "ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.onboardos }}"],
    "url_pattern": "/v1/onboarding/{path}",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_onboardos }}
    }
  }]
}
