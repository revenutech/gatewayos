{
  "endpoint": "/v1/admin/{path}",
  "method": "GET",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID"],
  "output_encoding": "no-op",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles": ["ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.ledgeros_http }}"],
    "url_pattern": "/v1/admin/{path}",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_posting }}
    }
  }]
},
{
  "endpoint": "/v1/admin/{path}",
  "method": "POST",
  "input_headers": ["X-User-ID", "X-Tenant-ID", "X-Roles", "X-Correlation-ID", "Content-Type"],
  "output_encoding": "no-op",
  "extra_config": {
    {{ template "jwt_validator.tmpl" . }},
    "auth/validator": {
      "roles_key": "realm_access.roles",
      "roles": ["ledger-admin"]
    }
  },
  "backend": [{
    "host": ["{{ .backends.ledgeros_http }}"],
    "url_pattern": "/v1/admin/{path}",
    "encoding": "no-op",
    "extra_config": {
      {{ template "circuit_breaker.tmpl" .cb_posting }}
    }
  }]
}